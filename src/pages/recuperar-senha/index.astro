---
import '../../styles/diary.css';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#110f21" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Recuperar senha — Diário do Universo</title>
  </head>
  <body>
    <div class="cosmic-backdrop" aria-hidden="true"><span class="cosmic-dust cosmic-dust-one"></span><span class="cosmic-dust cosmic-dust-two"></span><span class="cosmic-dust cosmic-dust-three"></span></div>
    <main class="shell" style="min-height:100vh;display:grid;align-content:center;max-width:680px;">
      <header class="topbar"><a class="brand" href="/">✦ Diário do Universo</a></header>
      <section class="card auth-panel" aria-labelledby="reset-title" style="display:block;">
        <div class="auth-heading">
          <span class="label">um novo começo</span>
          <h1 id="reset-title">Redefinir minha senha</h1>
        </div>
        <p class="auth-copy" id="reset-status" role="status" aria-live="polite">Validando seu link de recuperação…</p>
        <form id="reset-form" hidden>
          <label for="reset-password">Nova senha</label>
          <input id="reset-password" type="password" autocomplete="new-password" minlength="8" required placeholder="Pelo menos 8 caracteres" />
          <label for="reset-confirm">Confirme sua nova senha</label>
          <input id="reset-confirm" type="password" autocomplete="new-password" minlength="8" required />
          <button id="reset-submit" class="primary-button" type="submit">Salvar nova senha</button>
        </form>
        <p><a class="text-link" href="/">Voltar ao Diário do Universo</a></p>
      </section>
    </main>
    <script src="../../scripts/reset-password.ts"></script>
  </body>
</html>
