<style>
  /* Atmosfera ampla e discreta: profundidade sem virar uma imagem de fundo. */
  body::before,
  body::after {
    z-index: 0;
  }

  body::before {
    background:
      radial-gradient(ellipse at 50% 8%, rgba(110, 91, 183, 0.2), transparent 42%),
      radial-gradient(ellipse at 8% 58%, rgba(45, 212, 191, 0.08), transparent 38%),
      radial-gradient(ellipse at 92% 82%, rgba(244, 213, 141, 0.08), transparent 34%);
    filter: blur(18px);
    opacity: 0.8;
    animation: cosmic-atmosphere-drift 22s ease-in-out infinite alternate;
  }

  body::after {
    background:
      radial-gradient(circle at 12% 20%, rgba(244, 213, 141, 0.7) 0 1px, transparent 1.6px),
      radial-gradient(circle at 78% 14%, rgba(167, 243, 232, 0.58) 0 1px, transparent 1.6px),
      radial-gradient(circle at 88% 47%, rgba(244, 213, 141, 0.48) 0 1px, transparent 1.5px),
      radial-gradient(circle at 21% 76%, rgba(196, 181, 253, 0.42) 0 1px, transparent 1.5px),
      radial-gradient(ellipse at center, transparent 42%, rgba(5, 4, 14, 0.34) 100%);
    opacity: 0.34;
    mix-blend-mode: screen;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 18px;
    margin: 34px 4px 0;
    color: #9991a2;
    font-size: .72rem;
  }

  .site-footer a { color: #a7f3e8; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }

