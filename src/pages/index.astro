---
const entryTypes = [
  ['symbol', '✦', 'Símbolo'],
  ['dream', '☾', 'Sonho'],
  ['number', '#', 'Número'],
  ['animal', '♧', 'Animal'],
  ['color', '◉', 'Cor'],
  ['word', 'Aa', 'Palavra'],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#110f21" />
    <meta name="description" content="Um espaço simples e bonito para guardar sonhos, símbolos e sinais." />
    <title>Diário do Universo</title>
  </head>
  <body>
    <div class="cosmic-backdrop" aria-hidden="true">
      <span class="cosmic-dust cosmic-dust-one"></span>
      <span class="cosmic-dust cosmic-dust-two"></span>
      <span class="cosmic-dust cosmic-dust-three"></span>
    </div>
    <main class="shell">
      <header class="topbar">
        <span class="brand">✦ Diário do Universo</span>
        <button id="auth-toggle" class="link-button" type="button">Entrar</button>
      </header>

      <section class="hero">
        <div class="hero-logo-frame"><img class="hero-logo" src="/assets/diario-do-universo-celestial.webp" alt="Diário do Universo Celestial" /></div>
        <div class="orbit" aria-hidden="true">✦</div>
        <p class="eyebrow">um espaço para guardar</p>
        <h1>O que chamou sua atenção hoje?</h1>
        <p>Decifre os sinais, interprete e guarde as sincronicidades do seu universo!</p>
      </section>

      <section class="editorial-intro" aria-label="Sobre o Diário do Universo">
        <span class="editorial-intro-mark" aria-hidden="true">✦</span>
        <p>A caminhada do autoconhecimento é uma jornada longa, feita de escolhas, descobertas e possibilidades. O Diário do Universo é sua bússola — e sua companhia nessa viagem.</p>
      </section>

      <section id="auth-panel" class="card auth-panel" hidden aria-labelledby="auth-title">
        <div class="auth-heading"><span class="label">seu espaço pessoal</span><h2 id="auth-title">Entre para guardar seus sinais</h2></div>
        <p class="auth-copy">Uma conta independente para o Diário do Universo — sem depender do Palavras do Universo.</p>
        <form id="auth-form">
          <label for="auth-email">Seu email</label>
          <input id="auth-email" type="email" autocomplete="email" required placeholder="voce@exemplo.com" />
          <label for="auth-password">Senha</label>
          <input id="auth-password" type="password" autocomplete="current-password" minlength="6" required placeholder="Mínimo de 6 caracteres" />
          <div class="auth-actions"><button id="auth-submit" class="primary-button" type="submit">Entrar</button><button id="signup" class="secondary-button" type="button">Criar conta</button></div>
          <div class="auth-divider"><span>ou continue com</span></div>
          <div class="provider-actions"><button id="oauth-google" class="provider-button" type="button"><span aria-hidden="true">G</span> Continuar com Google</button><button id="oauth-facebook" class="provider-button" type="button"><span aria-hidden="true">f</span> Facebook</button><button id="oauth-apple" class="provider-button" type="button"><span aria-hidden="true">●</span> Apple</button><button id="passkey-signin" class="provider-button" type="button"><span aria-hidden="true">⌁</span> Chave de acesso</button></div>
        </form>
        <div class="signed-in" hidden><p id="signed-in-label"></p><div class="signed-in-actions"><button id="register-passkey" class="secondary-button" type="button">Adicionar chave de acesso</button><button id="signout" class="secondary-button" type="button">Sair</button></div></div>
        <p id="auth-notice" class="auth-notice" role="status"></p>
      </section>

      <section id="welcome-panel" class="welcome-panel" hidden aria-labelledby="welcome-title">
        <div class="welcome-orb" aria-hidden="true">✦</div>
        <div class="welcome-content">
          <span class="label">seu momento de presença</span>
          <h2 id="welcome-title">O universo deixou um sinal para você?</h2>
          <p>Comece por onde a sua atenção pousou. Não precisa interpretar tudo agora — apenas guarde o que chamou você.</p>
          <div class="quick-prompts" aria-label="Atalhos para começar">
            <button type="button" data-quick-type="dream" data-quick-title="Um sonho para lembrar">☾ <span>um sonho</span></button>
            <button type="button" data-quick-type="symbol" data-quick-title="Um símbolo que se repetiu">✦ <span>um símbolo</span></button>
            <button type="button" data-quick-type="word" data-quick-title="Uma palavra que ficou">Aa <span>uma palavra</span></button>
          </div>
        </div>
      </section>

      <section class="card composer" aria-labelledby="composer-title">
        <div class="section-heading"><div><span class="label">novo registro</span><h2 id="composer-title">O que você encontrou?</h2></div><button id="session-badge" class="session-badge" type="button">entre para guardar</button></div>
        <div class="types">{entryTypes.map(([type, icon, label], index) => <button class:list-active={index === 0} class="type" data-entry-type={type} type="button"><span aria-hidden="true">{icon}</span><small>{label}</small></button>)}</div>
        <input id="title" maxlength="160" placeholder="Dê um nome para este registro (opcional)" aria-label="Nome do registro" />
        <textarea id="body" maxlength="20000" placeholder="O que aconteceu? O que você viu ou encontrou?" aria-label="Conteúdo do registro"></textarea>
        <div class="when-row"><label for="occurred-at">Quando aconteceu?</label><input id="occurred-at" type="datetime-local" aria-label="Quando aconteceu" /></div>
        <div class="compose-foot"><span id="type-label">Símbolo</span><button id="save" class="primary-button" type="button" disabled>Guardar registro <span aria-hidden="true">→</span></button></div>
        <p id="notice" class="notice" role="status"></p>
      </section>

      <section class="collection" aria-labelledby="collection-title">
        <div class="collection-head"><div><span class="label">sua coleção</span><h2 id="collection-title">Meus sinais guardados</h2></div><strong><span id="count">0</span> ✦</strong></div>
        <div id="symbols" class="symbols" aria-label="Tipos registrados"></div>
        <div id="entries" class="entries"><div class="empty">✦<p>Entre para começar a guardar o que encontra pelo caminho.</p></div></div>
      </section>

      <section class="cosmic-garden" aria-labelledby="garden-title">
        <div class="garden-heading">
        <div><span class="label">olhe com calma</span><h2 id="garden-title">Jardim Cósmico</h2></div>
          <span id="garden-count" class="garden-count">0 sinais</span>
        </div>
        <p class="garden-copy">Cada sinal guardado encontra um lugar no seu céu. Com o tempo, os pontos começam a revelar caminhos, repetições e constelações próprias — sem pressa para nomear tudo.</p>
        <div class="garden-controls" aria-label="Filtros do Jardim Cósmico">
          <div class="garden-filter-group" role="group" aria-label="Filtrar por tipo de sinal">
            <button class="garden-filter active" data-garden-filter="all" type="button">todos</button>
            <button class="garden-filter" data-garden-filter="symbol" type="button">símbolos</button>
            <button class="garden-filter" data-garden-filter="dream" type="button">sonhos</button>
            <button class="garden-filter" data-garden-filter="number" type="button">números</button>
            <button class="garden-filter" data-garden-filter="animal" type="button">animais</button>
            <button class="garden-filter" data-garden-filter="color" type="button">cores</button>
            <button class="garden-filter" data-garden-filter="word" type="button">palavras</button>
          </div>
          <label class="garden-period-label" for="garden-period">período
            <select id="garden-period">
              <option value="all">todo o tempo</option>
              <option value="30">últimos 30 dias</option>
              <option value="90">últimos 90 dias</option>
              <option value="365">último ano</option>
            </select>
          </label>
        </div>
        <div id="garden-insights" class="garden-insights" aria-label="Pistas encontradas nos seus registros" aria-live="polite"></div>
        <div id="garden" class="garden" aria-live="polite">
          <div id="garden-stars" class="garden-stars"></div>
          <div id="garden-empty" class="garden-empty"><span aria-hidden="true">✦</span><p>Seu jardim começa com um sinal.</p><small>Guarde algo que chamou sua atenção para acender o primeiro ponto.</small></div>
        </div>
      </section>

      <aside class="bridge"><b aria-hidden="true">↗</b><p><strong>Um ecossistema, dois caminhos.</strong><br />Leituras e mapas do Palavras do Universo poderão ser guardados aqui com a origem preservada.</p></aside>
      <footer class="site-footer">
        <a href="/privacidade">Política de Privacidade</a>
        <a href="/termos">Termos de Serviço</a>
        <a href="/exclusao-de-dados">Excluir meus dados</a>
      </footer>
    </main>
    <script src="../scripts/app.ts"></script>
  </body>
</html>

<style>
  :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#fafafa;background:#110f21}*{box-sizing:border-box}body{position:relative;isolation:isolate;margin:0;min-height:100vh;overflow-x:hidden;background:radial-gradient(circle at 80% 0%,#4b3c8066,transparent 38%),radial-gradient(circle at 0 42%,#2f777322,transparent 32%),#110f21}body::before,body::after{position:fixed;inset:0;pointer-events:none;content:""}.shell{position:relative;z-index:1;max-width:760px;margin:auto;padding:22px 16px 72px}.topbar{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:.78rem}.brand{color:#f4d58d;font-weight:700}.link-button{border:0;background:none;color:#a7f3e8;cursor:pointer;font:inherit}.link-button:hover{text-decoration:underline}.hero{text-align:center;padding:68px 14px 36px}.hero-logo-frame{width:700px;max-width:100%;margin:0 auto 24px;padding:0;overflow:hidden;border:0;border-radius:0;background:none;box-shadow:none;transform:translateY(-40px)}.hero-logo{display:block;width:100%;height:auto;filter:none}.orbit{display:grid;place-items:center;width:68px;height:68px;margin:auto;border:1px solid #8bd8c855;border-radius:50%;color:#f4d58d;font-size:1.5rem;box-shadow:0 0 50px #8bd8c81f}.eyebrow,.label{color:#8bd8c8;font-size:.7rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.hero h1{max-width:580px;margin:14px auto 0;font:600 clamp(2.3rem,8vw,4.5rem)/1.04 Georgia,serif;letter-spacing:-.04em}.hero p:last-child{max-width:380px;margin:18px auto 0;color:#cfc4d2;font-size:1.16rem;line-height:1.4}.card{border:1px solid #ffffff14;border-radius:24px;background:linear-gradient(145deg,#202027e6,#15151ad9);box-shadow:0 24px 80px #00000038}.auth-panel{padding:22px;margin-bottom:14px}.auth-heading h2,.section-heading h2{margin:7px 0 0;font:600 clamp(1.5rem,5vw,2rem)/1.08 Georgia,serif}.auth-copy{max-width:500px;color:#cfc4d2;font-size:.85rem;line-height:1.5}.auth-panel form{display:grid;gap:8px;max-width:520px}.auth-panel label,.when-row label{margin-top:7px;color:#a1a1aa;font-size:.72rem}.auth-panel input,.composer input,.composer textarea{width:100%;border:1px solid #ffffff1c;border-radius:14px;background:#09090b66;color:#fafafa;outline:0;padding:14px 15px;font-size:15px;font-weight:500;box-shadow:inset 0 1px #ffffff0a,0 5px 18px #00000014;transition:border-color .2s ease,background .2s ease,box-shadow .2s ease}.auth-panel input::placeholder,.composer input::placeholder,.composer textarea::placeholder{color:#8f8999}.auth-panel input:focus,.composer input:focus,.composer textarea:focus{border-color:#2dd4bf;background:#0c1718a6;box-shadow:0 0 0 3px #2dd4bf1c,0 0 26px #2dd4bf12}.auth-actions,.signed-in{display:flex;align-items:center;gap:9px;margin-top:11px}.primary-button,.secondary-button{border:0;border-radius:999px;padding:11px 16px;font-weight:800;cursor:pointer}.primary-button{background:#f4d58d;color:#211a27}.primary-button:hover{background:#ffe7a9}.secondary-button{background:#ffffff0d;color:#d8fff8;border:1px solid #2dd4bf55}.auth-divider{display:flex;align-items:center;gap:12px;margin:18px 0 2px;color:#71717a;font-size:.68rem}.auth-divider::before,.auth-divider::after{content:"";height:1px;flex:1;background:#ffffff14}.provider-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.provider-button{display:flex;align-items:center;justify-content:center;gap:7px;border:1px solid #ffffff1c;border-radius:12px;background:#ffffff08;color:#f4f4f5;padding:11px 9px;font:inherit;font-size:.76rem;cursor:pointer;transition:border-color .2s ease,background .2s ease,transform .2s ease}.provider-button:hover{transform:translateY(-2px);border-color:#f4d58d88;background:#f4d58d12}.provider-button:focus-visible{outline:2px solid #f4d58d;outline-offset:3px}.provider-button span{color:#f4d58d;font-weight:800}.auth-notice,.notice{min-height:18px;margin:10px 0 0;color:#2dd4bf;font-size:.75rem}.auth-notice{max-width:560px}.signed-in{justify-content:space-between;flex-wrap:wrap}.signed-in p{margin:0;color:#cfc4d2;font-size:.8rem}.signed-in-actions{display:flex;gap:8px;flex-wrap:wrap}.composer{padding:20px}.section-heading{display:flex;align-items:start;justify-content:space-between;gap:12px}.session-badge{padding:6px 9px;border:1px solid #f4d58d44;border-radius:999px;background:transparent;color:#f4d58d;font:inherit;font-size:.65rem;white-space:nowrap;cursor:pointer;transition:border-color .2s ease,background .2s ease,transform .2s ease}.session-badge:hover{transform:translateY(-1px);border-color:#f4d58d99;background:#f4d58d12}.session-badge:focus-visible{outline:2px solid #f4d58d;outline-offset:3px}.session-badge.ready{border-color:#2dd4bf55;color:#a7f3e8}.types{display:flex;gap:8px;margin:16px -4px 20px;overflow:auto;padding:2px 4px 7px;scrollbar-width:thin}.type{min-width:70px;padding:11px 8px;border:1px solid #ffffff1c;border-radius:15px;background:linear-gradient(145deg,#ffffff0d,#8bd8c80a);color:#a1a1aa;font-size:1.1rem;backdrop-filter:blur(10px);box-shadow:inset 0 1px #ffffff0d,0 5px 18px #00000018;cursor:pointer;transition:transform .2s ease,border-color .2s ease,background .2s ease,color .2s ease,box-shadow .2s ease}.type small{display:block;margin-top:5px;font-size:.68rem}.type:hover{transform:translateY(-3px);border-color:#8bd8c899;background:linear-gradient(145deg,#2dd4bf26,#f4d58d12);color:#eafffa;box-shadow:0 8px 24px #2dd4bf1c}.type:focus-visible,.link-button:focus-visible,.primary-button:focus-visible,.secondary-button:focus-visible{outline:2px solid #f4d58d;outline-offset:3px}.type.active,.type.list-active{border-color:#2dd4bf99;background:linear-gradient(145deg,#2dd4bf30,#f4d58d14);color:#b8fff3;box-shadow:0 0 0 1px #2dd4bf24,0 8px 24px #2dd4bf1c}.composer textarea{min-height:120px;margin-top:10px;resize:vertical;line-height:1.6}.when-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:10px}.when-row input{max-width:235px;padding:10px 12px}.compose-foot{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:13px;color:#a1a1aa;font-size:.75rem}.compose-foot button:disabled{opacity:.4;cursor:not-allowed}.notice{text-align:right}.collection{padding:48px 4px 0}.collection-head{display:flex;justify-content:space-between;align-items:end}.collection h2{margin:7px 0 0;font:600 clamp(1.7rem,6vw,2.4rem)/1.08 Georgia,serif}.collection-head strong{color:#f4d58d}.symbols{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.symbols span{padding:7px 11px;border:1px solid #2dd4bf38;border-radius:999px;background:#2dd4bf1f;color:#a7f3e8;font-size:.75rem}.entries{display:grid;gap:11px;margin-top:18px}.entry,.empty{padding:19px;border:1px solid #ffffff14;border-radius:22px;background:#18181ba6}.entry{display:grid;grid-template-columns:1fr auto;gap:0 14px}.entry small{color:#2dd4bf;font-size:.7rem}.entry h3{margin:7px 0 0;font-size:1.05rem}.entry time{color:#71717a;font-size:.72rem}.entry p{grid-column:1/-1;margin:11px 0 0;color:#cfc4d2;font-size:.88rem;line-height:1.65;white-space:pre-wrap}.entry-delete{grid-column:2;grid-row:2;border:0;background:none;color:#9e96aa;font-size:.72rem;cursor:pointer}.entry-delete:hover{color:#fca5a5}.empty{text-align:center;color:#a1a1aa}.empty:first-letter{color:#f4d58d;font-size:1.5rem}.empty p{margin:8px 0 0;font-size:.85rem}.bridge{display:flex;gap:13px;margin:38px 4px 0;padding:17px;border:1px solid #3b82f638;border-radius:20px;background:#3b82f612;color:#d4d4d8}.bridge>b{color:#22d3ee;font-size:1.4rem}.bridge p{margin:0;font-size:.76rem;line-height:1.55}.bridge strong{color:#fafafa}@media(min-width:700px){.shell{padding-top:30px}.hero{padding-top:82px}.composer{padding:28px}}@media(max-width:520px){.when-row{align-items:stretch;flex-direction:column}.when-row input{max-width:none}.section-heading{display:block}.session-badge{display:inline-flex;margin-top:12px}.provider-actions{grid-template-columns:1fr}.signed-in-actions{width:100%}.shell{position:relative}}@media(max-width:420px){.hero-logo-frame{width:min(100%,340px);margin-bottom:20px}.link-note{font-size:.68rem}}
