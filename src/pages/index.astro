<style>
  .cosmic-backdrop {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 4%, rgba(108, 84, 190, 0.3), transparent 42%),
      radial-gradient(ellipse at 5% 48%, rgba(24, 147, 157, 0.14), transparent 36%),
      radial-gradient(ellipse at 93% 78%, rgba(180, 91, 151, 0.12), transparent 34%);
    opacity: 0.92;
  }

  .cosmic-backdrop::before,
  .cosmic-backdrop::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }

  .cosmic-backdrop::before {
    inset: -12%;
    background-image:
      radial-gradient(circle, rgba(255, 238, 190, 0.92) 0 1px, transparent 1.7px),
      radial-gradient(circle, rgba(161, 243, 232, 0.7) 0 1px, transparent 1.8px),
      radial-gradient(circle, rgba(210, 190, 255, 0.7) 0 1.2px, transparent 2px);
    background-position: 12px 28px, 76px 112px, 138px 54px;
    background-size: 174px 196px, 236px 254px, 318px 286px;
    opacity: 0.48;
    animation: cosmic-starfield 42s linear infinite;
  }

  .cosmic-backdrop::after {
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 26%, rgba(7, 5, 19, 0.12) 66%, rgba(4, 3, 12, 0.62) 100%),
      radial-gradient(ellipse at 50% 26%, rgba(244, 213, 141, 0.1), transparent 30%);
    mix-blend-mode: screen;
  }

  .cosmic-dust {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(244, 213, 141, 0.85);
    box-shadow:
      80px 110px 0 rgba(167, 243, 232, 0.5),
      190px 42px 0 rgba(196, 181, 253, 0.55),
      330px 180px 0 rgba(244, 213, 141, 0.44),
      490px 74px 0 rgba(167, 243, 232, 0.38),
      650px 240px 0 rgba(196, 181, 253, 0.46),
      790px 126px 0 rgba(244, 213, 141, 0.42),
      930px 300px 0 rgba(167, 243, 232, 0.38),
      1080px 92px 0 rgba(244, 213, 141, 0.5),
      1240px 360px 0 rgba(196, 181, 253, 0.42),
      1380px 160px 0 rgba(167, 243, 232, 0.44);
    opacity: 0.5;
    filter: blur(0.2px);
    animation: cosmic-drift 24s ease-in-out infinite alternate;
  }

  .cosmic-dust-one { left: 8%; top: 18%; }
  .cosmic-dust-two {
    left: 22%;
    top: 62%;
    transform: scale(0.7);
    animation-duration: 31s;
    animation-delay: -9s;
    opacity: 0.34;
  }
  .cosmic-dust-three {
    left: 4%;
    top: 84%;
    transform: scale(0.5);
    animation-duration: 37s;
    animation-delay: -15s;
    opacity: 0.28;
  }

  @keyframes cosmic-starfield {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(-2.5%, 1.5%, 0) rotate(1deg); }
  }

  @keyframes cosmic-drift {
    from { transform: translate3d(-2vw, 1vh, 0) scale(1); }
    to { transform: translate3d(7vw, -4vh, 0) scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cosmic-backdrop::before,
    .cosmic-dust { animation: none; }
  }
</style>

